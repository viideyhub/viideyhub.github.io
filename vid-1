/* =========================================================
   ADSTERRA SMARTLINK
   ========================================================= */

const DIRECT_LINK =
  "https://conductivebreeds.com/exxiy8k45?key=ca148b31d37f592e093f740cd1b84e8a";


/* =========================================================
   KONFIGURASI
   ========================================================= */

const PER_PAGE = 10;

let currentPage = 1;
let filteredVideos = [...VIDEO_URLS];


/* =========================================================
   ELEMENT
   ========================================================= */

const grid =
  document.getElementById("videoGrid");

const pagination =
  document.getElementById("pagination");

const searchInput =
  document.getElementById("searchInput");

const pageInfo =
  document.getElementById("pageInfo");

const modal =
  document.getElementById("playerModal");

const player =
  document.getElementById("mainPlayer");

const playerTitle =
  document.getElementById("playerTitle");

const directButton =
  document.getElementById("directButton");


/* =========================================================
   JUDUL VIDEO
   ========================================================= */

function videoTitle(index){

  return "Video " +
    String(index + 1).padStart(3,"0");

}


/* =========================================================
   RENDER VIDEO
   ========================================================= */

function render(){

  const totalPages =
    Math.max(
      1,
      Math.ceil(
        filteredVideos.length / PER_PAGE
      )
    );

  if(currentPage > totalPages){

    currentPage = totalPages;

  }

  const start =
    (currentPage - 1) * PER_PAGE;

  const items =
    filteredVideos.slice(
      start,
      start + PER_PAGE
    );

  grid.innerHTML = "";


  if(!items.length){

    grid.innerHTML =
      '<div class="empty">Belum ada video.</div>';

  }else{

    items.forEach(
      (url,localIndex)=>{

        const absoluteIndex =
          start + localIndex;


        const card =
          document.createElement("article");

        card.className =
          "video-card";


        const thumb =
          document.createElement("div");

        thumb.className =
          "thumbnail";


        const preview =
          document.createElement("video");

        preview.src = url;

        preview.muted = true;

        preview.playsInline = true;

        preview.preload = "metadata";


        const overlay =
          document.createElement("div");

        overlay.className =
          "thumb-overlay";

        overlay.innerHTML =
          "<span>▶ Video</span>" +
          "<span>HD</span>";


        thumb.appendChild(preview);

        thumb.appendChild(overlay);


        const info =
          document.createElement("div");

        info.className =
          "info";

        info.innerHTML =
          '<div class="likes">👍 100%</div>' +
          '<div class="title">' +
          videoTitle(absoluteIndex) +
          '</div>';


        card.appendChild(thumb);

        card.appendChild(info);


        card.addEventListener(
          "click",
          ()=>{
            openPlayer(
              url,
              videoTitle(absoluteIndex)
            );
          }
        );


        grid.appendChild(card);

      }
    );

  }


  pageInfo.textContent =
    filteredVideos.length
      ? `${start + 1}-${Math.min(
          start + PER_PAGE,
          filteredVideos.length
        )} dari ${filteredVideos.length}`
      : "0 video";


  renderPagination(totalPages);

}


/* =========================================================
   PAGINATION
   ========================================================= */

function renderPagination(totalPages){

  pagination.innerHTML = "";

  if(totalPages <= 1){

    return;

  }


  const addButton =
    (
      text,
      page,
      active = false,
      disabled = false
    )=>{

      const btn =
        document.createElement("button");

      btn.textContent = text;

      if(active){

        btn.classList.add("active");

      }

      btn.disabled =
        disabled;


      btn.addEventListener(
        "click",
        ()=>{

          currentPage = page;

          render();

          window.scrollTo({
            top:0,
            behavior:"smooth"
          });

        }
      );


      pagination.appendChild(btn);

    };


  const maxVisible = 5;

  let start =
    Math.max(
      1,
      currentPage - 2
    );

  let end =
    Math.min(
      totalPages,
      start + maxVisible - 1
    );


  if(
    end - start + 1 <
    maxVisible
  ){

    start =
      Math.max(
        1,
        end - maxVisible + 1
      );

  }


  if(currentPage > 1){

    addButton(
      "Previous",
      currentPage - 1
    );

  }


  for(
    let p = start;
    p <= end;
    p++
  ){

    addButton(
      String(p),
      p,
      p === currentPage
    );

  }


  if(currentPage < totalPages){

    addButton(
      "Next",
      currentPage + 1
    );

  }


  if(currentPage !== totalPages){

    addButton(
      "Last",
      totalPages
    );

  }

}


/* =========================================================
   OPEN PLAYER
   ========================================================= */

function openPlayer(url,title){

  playerTitle.textContent =
    title;

  player.src =
    url;


  directButton.href =
    DIRECT_LINK;


  directButton.style.display =
    "inline-block";


  modal.style.display =
    "flex";


  document.body.style.overflow =
    "hidden";


  player.play().catch(
    ()=>{}
  );

}


/* =========================================================
   CLOSE PLAYER
   ========================================================= */

function closePlayer(){

  player.pause();

  player.removeAttribute(
    "src"
  );

  player.load();

  modal.style.display =
    "none";

  document.body.style.overflow =
    "";

}


/* =========================================================
   CLOSE BUTTON
   ========================================================= */

document
  .getElementById("closePlayer")
  .addEventListener(
    "click",
    closePlayer
  );


/* =========================================================
   CLOSE KLIK LUAR PLAYER
   ========================================================= */

modal.addEventListener(
  "click",
  (e)=>{

    if(e.target === modal){

      closePlayer();

    }

  }
);


/* =========================================================
   ESCAPE
   ========================================================= */

document.addEventListener(
  "keydown",
  (e)=>{

    if(e.key === "Escape"){

      closePlayer();

    }

  }
);


/* =========================================================
   SEARCH
   ========================================================= */

function doSearch(){

  const q =
    searchInput.value
      .trim()
      .toLowerCase();


  if(!q){

    filteredVideos =
      [...VIDEO_URLS];

  }else{

    filteredVideos =
      VIDEO_URLS.filter(
        (url,index)=>{

          return (
            videoTitle(index)
              .toLowerCase()
              .includes(q)

            ||

            url
              .toLowerCase()
              .includes(q)
          );

        }
      );

  }


  currentPage = 1;

  render();

}


/* =========================================================
   SEARCH EVENTS
   ========================================================= */

searchInput.addEventListener(
  "input",
  doSearch
);

document
  .getElementById("searchBtn")
  .addEventListener(
    "click",
    doSearch
  );


/* =========================================================
   START
   ========================================================= */

render();

</script>


