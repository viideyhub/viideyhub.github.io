<style>
:root{
  --bg:#1a1a1a;
  --header:#202020;
  --card:#000;
  --accent:#5c20d6;
  --text:#fff;
  --muted:#b3b3b3;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.5;
}

a{
  text-decoration:none;
  color:inherit;
}

header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:15px 50px;
  background:var(--header);
  border-bottom:1px solid #333;
}

.logo{
  font-size:26px;
  font-weight:bold;
  font-style:italic;
  color:#8b5cf6;
}

.search-box{
  display:flex;
  background:#111;
  border:1px solid #333;
  border-radius:4px;
  overflow:hidden;
}

.search-box input{
  background:transparent;
  border:0;
  outline:0;
  color:#fff;
  padding:10px 15px;
  width:250px;
}

.search-box button{
  border:0;
  background:var(--accent);
  color:#fff;
  padding:10px 18px;
  cursor:pointer;
}

nav{
  display:flex;
  gap:10px;
  overflow-x:auto;
  white-space:nowrap;
  padding:10px 50px;
  background:var(--header);
  border-bottom:1px solid #222;
}

nav a{
  padding:8px 15px;
  color:#ddd;
  font-size:13px;
  font-weight:bold;
  border-radius:3px;
}

nav a:hover,
nav a.active{
  background:var(--accent);
  color:#fff;
}

main{
  padding:30px 50px;
  min-height:80vh;
}

.section-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
  background:#252525;
  padding:8px 15px;
  border-left:3px solid var(--accent);
  border-radius:3px;
}

.section-header h2{
  font-size:14px;
  font-weight:normal;
  color:#eee;
}

.video-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:30px 15px;
}

.video-card{
  cursor:pointer;
  transition:.2s;
}

.video-card:hover{
  transform:translateY(-3px);
}

.thumbnail{
  position:relative;
  width:100%;
  aspect-ratio:16/9;
  background:#000;
  overflow:hidden;
  border-radius:3px;
}

.thumbnail video{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

.thumb-overlay{
  position:absolute;
  inset:auto 0 0;
  padding:6px 8px;
  display:flex;
  justify-content:space-between;
  background:linear-gradient(
    transparent,
    rgba(0,0,0,.9)
  );
  font-size:11px;
  font-weight:bold;
  pointer-events:none;
}

.info{
  text-align:center;
  padding-top:8px;
}

.likes{
  font-size:11px;
  font-weight:bold;
  margin-bottom:4px;
}

.title{
  font-size:12px;
  color:var(--muted);
  line-height:1.4;
}

.pagination{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:6px;
  margin:50px 0 20px;
}

.pagination button{
  background:#2a2a2a;
  color:#ccc;
  border:0;
  padding:8px 14px;
  border-radius:3px;
  cursor:pointer;
  font-size:13px;
  font-weight:bold;
}

.pagination button:hover,
.pagination button.active{
  background:var(--accent);
  color:#fff;
}

.pagination button:disabled{
  opacity:.5;
  cursor:default;
}

footer{
  background:#1a1a1a;
  padding:30px 20px;
  text-align:center;
  border-top:1px solid #333;
}

.footer-links{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:20px;
  margin-bottom:15px;
}

.footer-links a{
  color:var(--accent);
  font-size:12px;
  font-weight:bold;
}

footer p{
  color:#666;
  font-size:11px;
}

/* =========================
   PLAYER
   ========================= */

.player-modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.92);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:99999;
  padding:18px;
}

.player-box{
  width:min(950px,100%);
  background:#111;
  border-radius:8px;
  overflow:hidden;
}

.player-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:10px 14px;
  background:#202020;
}

.player-title{
  font-size:14px;
  font-weight:bold;
}

.close-player{
  border:0;
  background:#333;
  color:#fff;
  border-radius:4px;
  padding:7px 11px;
  cursor:pointer;
}

#mainPlayer{
  display:block;
  width:100%;
  max-height:75vh;
  background:#000;
}

.player-actions{
  padding:12px;
  text-align:center;
}

.direct-btn{
  display:inline-block;
  background:var(--accent);
  color:#fff;
  padding:10px 18px;
  border-radius:5px;
  font-weight:bold;
  font-size:13px;
}

.empty{
  grid-column:1/-1;
  text-align:center;
  color:#777;
  padding:50px 10px;
}

/* =========================
   RESPONSIVE
   ========================= */

@media(max-width:1024px){
  .video-grid{
    grid-template-columns:repeat(3,1fr);
  }
}

@media(max-width:768px){

  header,
  nav,
  main{
    padding-left:20px;
    padding-right:20px;
  }

  header{
    gap:15px;
  }

  .search-box{
    width:100%;
  }

  .search-box input{
    width:100%;
  }

  .video-grid{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:480px){

  header{
    flex-direction:column;
  }

  .video-grid{
    grid-template-columns:1fr;
  }

  .logo{
    font-size:22px;
  }

  main{
    padding-top:20px;
  }
}
</style>
</head>

